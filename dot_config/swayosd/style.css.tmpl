/* Color definitions shared by the GTK panels. wofi needs the absolute path
   because it hands the stylesheet to GTK as data rather than as a file, and
   the other panels use the same form so that a single generated file serves
   all of them. The path is filled in by chezmoi. */
@import url("file://{{ .chezmoi.homeDir }}/.config/matugen/colors.css");

window#osd {
  border-radius: 16px;
  border: 1px solid @outline_variant;
  background: alpha(@surface_container, 0.8);
  padding: 4px;
}

window#osd #container {
  margin: 16px;
}

window#osd image,
window#osd label {
  color: @on_surface;
}

window#osd label {
  font-family: "Adwaita Sans", "Hack Nerd Font", "Noto Sans CJK JP", sans-serif;
  font-feature-settings: "tnum";
  font-size: 14px;
}

window#osd progressbar:disabled,
window#osd image:disabled {
  opacity: 0.5;
}

window#osd progressbar,
window#osd segmentedprogress {
  min-height: 6px;
  border-radius: 999px;
  background: transparent;
  border: none;
}

window#osd trough,
window#osd segment {
  min-height: inherit;
  border-radius: inherit;
  border: none;
  background: @surface_container_highest;
}

window#osd progress,
window#osd segment.active {
  min-height: inherit;
  border-radius: inherit;
  border: none;
  background: @primary;
}

window#osd segment {
  margin-left: 8px;
}

window#osd segment:first-child {
  margin-left: 0;
}
